# Reguła dostępowa stosowana na etapie implementacji, wyłączona z powodu testów
# RULE ALLOW IF context.action == "READ" AND resource.type == "user" AND (subject.id == resource.id OR subject.role == "manager")

# Reguła delegacji stosowana na etapie implementacji
DELEGATION {
    rule: delegator.id == resource.id OR delegator.role == "manager"
    resource_type: "user"
    delegator_type: "user"
    delegatee_type: "user"
    actions: ["READ"]
    active: "true"
    max_duration: P7D
    max_depth: 1
}